CONFIG_DEFAULT_DEVICE_TREE="stm32mp135d-odyssey"
CONFIG_BOOTDELAY=3
CONFIG_BOOTCOMMAND="ext4load mmc 0:5 ${kernel_addr_r} /boot/zImage; ext4load mmc 0:5 ${fdt_addr_r} /boot/stm32mp135d-odyssey-grove.dtb; setenv bootargs \"root=/dev/mmcblk0p5 rootwait rw console=ttySTM0,115200n8 earlycon\"; bootz ${kernel_addr_r} - ${fdt_addr_r}"
# CONFIG_SILENT_CONSOLE is not set
# CONFIG_DISABLE_CONSOLE is not set
CONFIG_SYS_CONSOLE_ENV_OVERWRITE=y
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# CONFIG_ENV_IS_IN_UBI is not set
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_BASE=0x40010000
CONFIG_DEBUG_UART_CLOCK=64000000
CONFIG_DEBUG_UART_ANNOUNCE=y
